{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"cf-typegen": {},
		"check-types": {},
		"destroy": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"format": {},
		"lint": {},
		"migrate:dev": {},
		"storybook": {
			"with": ["storybook:styles"]
		},
		"storybook:styles": {
			"cache": false,
			"persistent": true
		},
		"studio": {},
		"test": {},
		"test:run": {},
		"up": {}
	},
	"ui": "tui"
}
