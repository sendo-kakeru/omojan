{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-09-22",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MatchingDurableObject",
				"name": "MATCHING_DURABLE_OBJECT"
			},
			{
				"class_name": "GameDurableObject",
				"name": "GAME_DURABLE_OBJECT"
			}
		]
	},
	"env": {
		"e2e": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MatchingDurableObject",
						"name": "MATCHING_DURABLE_OBJECT"
					},
					{
						"class_name": "GameDurableObject",
						"name": "GAME_DURABLE_OBJECT"
					}
				]
			},
			"vars": {
				"ENV": "e2e",
				"WEB_URL": "http://localhost:5173"
			}
		},
		"production": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MatchingDurableObject",
						"name": "MATCHING_DURABLE_OBJECT"
					},
					{
						"class_name": "GameDurableObject",
						"name": "GAME_DURABLE_OBJECT"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "MEDIA_BUCKET",
					"bucket_name": "omojan-media-prod"
				}
			],
			"routes": [
				{
					"custom_domain": true,
					"pattern": "api.omojan.com"
				}
			],
			// 2時間ごとにクリーンアップを実行
			"triggers": {
				"crons": ["0 */2 * * *"]
			},
			"vars": {
				"ENV": "production",
				"MEDIA_BUCKET_PUBLIC_URL": "https://media.omojan.com",
				"WEB_URL": "https://omojan.com"
			}
		},
		"staging": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MatchingDurableObject",
						"name": "MATCHING_DURABLE_OBJECT"
					},
					{
						"class_name": "GameDurableObject",
						"name": "GAME_DURABLE_OBJECT"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "MEDIA_BUCKET",
					"bucket_name": "omojan-media-stg"
				}
			],
			"routes": [
				{
					"custom_domain": true,
					"pattern": "api-stg.omojan.com"
				}
			],
			"vars": {
				"ENV": "staging",
				"MEDIA_BUCKET_PUBLIC_URL": "https://media-stg.omojan.com",
				"WEB_URL": "https://stg.omojan.com"
			}
		}
	},
	"main": "src/index.ts",
	"migrations": [
		{
			"new_sqlite_classes": ["MatchingDurableObject"],
			"tag": "matching-v1"
		},
		{
			"new_sqlite_classes": ["GameDurableObject"],
			"tag": "game-v1"
		}
	],
	"name": "api",
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "omojan-media-local"
		}
	]
}
