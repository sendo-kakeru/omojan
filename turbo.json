{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"cf-typegen": {},
		"check-types": {},
		"destroy": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"format": {},
		"lint": {},
		"migrate": {},
		"studio": {},
		"up": {}
	},
	"ui": "tui"
}
