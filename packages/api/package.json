{
	"dependencies": {
		"@repo/db": "workspace:*",
		"hono": "^4.9.8"
	},
	"devDependencies": {
		"@repo/tsup-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"wrangler": "^4.4.0"
	},
	"name": "@repo/api",

	"scripts": {
		"build": "pnpm run cf-typegen && pnpm run build:tsup && pnpm run build:tsc",
		"build:tsc": "tsc",
		"build:tsup": "tsup --clean",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"deploy": "wrangler deploy --minify",
		"dev": "pnpm run dev:tsup & pnpm run dev:tsc & pnpm run dev:wrangler",
		"dev:tsc": "tsc --watch",
		"dev:tsup": "tsup --watch",
		"dev:wrangler": "wrangler dev",
		"format": "biome check --fix --unsafe .",
		"lint": "biome check .",
		"type-check": "pnpm run cf-typegen && tsc --noEmit"
	},
	"type": "module"
}
