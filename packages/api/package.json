{
	"dependencies": {
		"@repo/db": "workspace:*",
		"@repo/shared": "workspace:*",
		"@hono/valibot-validator": "^0.5.3",
		"@neondatabase/serverless": "^1.0.2",
		"aws-jwt-verify": "^5.1.1",
		"drizzle-orm": "^0.44.5",
		"drizzle-valibot": "^0.4.2",
		"hono": "^4.10.3",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@repo/tsup-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/mock": "workspace:*",
		"@faker-js/faker": "^10.0.0",
		"@types/pg": "^8.15.5",
		"pg": "^8.16.3",
		"vitest": "^3.2.4",
		"wrangler": "^4.43.0"
	},
	"exports": {
		".": "./dist/index.d.ts"
	},
	"license": "UNLICENSED",
	"name": "@repo/api",
	"private": true,
	"scripts": {
		"build": "pnpm run cf-typegen && pnpm run build:tsup && pnpm run build:tsc",
		"build:tsc": "tsc -p tsconfig.build.json",
		"build:tsup": "tsup --clean",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"deploy": "wrangler deploy --minify",
		"dev": "pnpm run dev:tsup & pnpm run dev:tsc & pnpm run dev:wrangler",
		"dev:tsc": "tsc --watch",
		"dev:tsup": "tsup --watch",
		"dev:wrangler": "wrangler dev",
		"format": "biome check --fix --unsafe .",
		"lint": "biome check .",
		"test": "DATABASE_URL=postgresql://test:test@localhost:5432/test?schema=public vitest",
		"test:run": "DATABASE_URL=postgresql://test:test@localhost:5432/test?schema=public vitest run",
		"typecheck": "pnpm run cf-typegen && tsc --noEmit"
	},
	"type": "module",
	"version": "1.0.0"
}
