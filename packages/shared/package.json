{
	"dependencies": {
		"aws-jwt-verify": "5.2.1",
		"drizzle-valibot": "0.4.2",
		"hono": "4.13.8",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@repo/tsup-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "24.13.6"
	},
	"exports": {
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/esm/*.js",
			"require": "./dist/*.js"
		}
	},
	"license": "UNLICENSED",
	"name": "@repo/shared",
	"private": true,
	"scripts": {
		"dev": "pnpm run \"/^dev:/\"",
		"dev:tsup": "tsup --watch",
		"dev:tsc": "tsc --watch",
		"build": "pnpm run build:tsup && pnpm run build:tsc",
		"build:tsup": "tsup --clean",
		"build:tsc": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"version": "1.0.0"
}
