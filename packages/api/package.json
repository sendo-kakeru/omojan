{
	"dependencies": {
		"@hono/valibot-validator": "^0.5.3",
		"@neondatabase/serverless": "^1.0.2",
		"@repo/db": "workspace:*",
		"aws-jwt-verify": "^5.1.1",
		"drizzle-orm": "^0.44.5",
		"hono": "^4.9.8",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@repo/tsup-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/pg": "^8.15.5",
		"wrangler": "^4.4.0"
	},
	"exports": {
		".": "./dist/index.d.ts"
	},
	"license": "UNLICENSED",
	"name": "@repo/api",
	"private": true,
	"scripts": {
		"build": "pnpm run cf-typegen && pnpm run build:tsup && pnpm run build:tsc",
		"build:tsc": "tsc",
		"build:tsup": "tsup --clean",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"deploy": "wrangler deploy --minify",
		"dev": "pnpm run dev:tsup & pnpm run dev:tsc & pnpm run dev:wrangler",
		"dev:tsc": "tsc --watch",
		"dev:tsup": "tsup --watch",
		"dev:wrangler": "wrangler dev",
		"format": "biome check --fix --unsafe .",
		"lint": "biome check .",
		"type-check": "pnpm run cf-typegen && tsc --noEmit"
	},
	"type": "module",
	"version": "1.0.0"
}
