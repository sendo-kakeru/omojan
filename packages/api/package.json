{
	"dependencies": {
		"@libsql/client": "0.17.3",
		"@noble/hashes": "2.2.0",
		"@oslojs/encoding": "1.1.0",
		"@repo/db": "workspace:*",
		"@repo/shared": "workspace:*",
		"aws-jwt-verify": "5.1.1",
		"drizzle-orm": "0.45.2",
		"drizzle-valibot": "0.4.2",
		"hono": "4.12.18",
		"p-retry": "8.0.0",
		"valibot": "1.4.2"
	},
	"devDependencies": {
		"@faker-js/faker": "10.5.0",
		"@repo/mock": "workspace:*",
		"@repo/tsup-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "24.13.3",
		"drizzle-seed": "0.3.1",
		"tsx": "4.20.6",
		"vitest": "4.1.6",
		"wrangler": "4.80.0"
	},
	"exports": {
		".": "./dist/index.d.ts"
	},
	"license": "UNLICENSED",
	"name": "@repo/api",
	"private": true,
	"scripts": {
		"build": "pnpm run cf-typegen && pnpm run build:tsup && pnpm run build:tsc",
		"build:tsc": "tsc -p tsconfig.build.json",
		"build:tsup": "tsup --clean",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"deploy": "wrangler deploy --minify",
		"dev": "pnpm run dev:tsup & pnpm run dev:tsc & pnpm run dev:wrangler",
		"dev:tsc": "tsc --watch",
		"dev:tsup": "tsup --watch",
		"dev:wrangler": "wrangler dev",
		"dev:e2e": "wrangler dev --env e2e",
		"format": "biome check --fix --unsafe .",
		"lint": "biome check .",
		"test": "tsx ./src/__tests__/vitest-with-db.ts",
		"test:run": "tsx ./src/__tests__/vitest-with-db.ts run",
		"typecheck": "pnpm run cf-typegen && tsc --noEmit"
	},
	"type": "module",
	"version": "1.0.0"
}
