{
	"devDependencies": {
		"@repo/shared": "workspace:*",
		"@repo/tsup-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "24.13.5",
		"drizzle-kit": "0.31.11",
		"dotenv": "18.0.2",
		"drizzle-orm": "0.45.3",
		"drizzle-valibot": "0.4.2",
		"drizzle-seed": "0.3.1",
		"tsx": "4.23.13",
		"valibot": "1.5.0"
	},
	"exports": {
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"import": "./dist/esm/schemas/index.js",
			"require": "./dist/schemas/index.js"
		},
		"./models": {
			"types": "./dist/models/index.d.ts",
			"import": "./dist/esm/models/index.js",
			"require": "./dist/models/index.js"
		}
	},
	"license": "UNLICENSED",
	"name": "@repo/db",
	"private": true,
	"scripts": {
		"build": "pnpm run build:tsup && pnpm run build:tsc",
		"build:tsc": "tsc",
		"build:tsup": "tsup --clean",
		"dev": "pnpm run \"/^dev:/\"",
		"dev:tsc": "tsc --watch",
		"dev:tsup": "tsup --watch",
		"db:gen": "drizzle-kit generate",
		"db:migrate:prod": "ENV=production drizzle-kit migrate",
		"db:migrate:stg": "ENV=staging drizzle-kit migrate",
		"db:migrate:local": "drizzle-kit migrate",
		"db:migrate:e2e": "ENV=e2e drizzle-kit migrate",
		"db:drop:local": "drizzle-kit drop",
		"db:push:local": "drizzle-kit push",
		"db:dump": "rm -f src/dump.sql src/local.db && turso db shell omojan-main-local-sendo .dump > src/dump.sql && cat src/dump.sql | sqlite3 src/local.db",
		"db:reset:local": "tsx ./src/reset.ts",
		"db:changed": "pnpm run db:gen && pnpm run db:migrate:local && pnpm run db:migrate:e2e && pnpm run db:dump",
		"studio": "drizzle-kit studio",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"version": "1.0.0",
	"dependencies": {
		"uuidv7": "1.2.1"
	}
}
