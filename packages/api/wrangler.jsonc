{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-09-22",
	"compatibility_flags": ["nodejs_compat"],
	// "durable_objects": {
	// 	"bindings": [
	// 		{
	// 			"class_name": "Room",
	// 			"name": "ROOM"
	// 		}
	// 	]
	// },
	"env": {
		"production": {
			// "durable_objects": {
			// 	"bindings": [
			// 		{
			// 			"class_name": "Room",
			// 			"name": "ROOM"
			// 		}
			// 	]
			// },
			"routes": [{ "custom_domain": true, "pattern": "api.omojan.com" }],
			"vars": {
				"ENV": "production",
				"WEB_URL": "https://omojan.com"
			}
		},
		"staging": {
			// "durable_objects": {
			// 	"bindings": [
			// 		{
			// 			"class_name": "Room",
			// 			"name": "ROOM"
			// 		}
			// 	]
			// },
			"routes": [{ "custom_domain": true, "pattern": "api-stg.omojan.com" }],
			"vars": {
				"ENV": "staging",
				"WEB_URL": "https://stg.omojan.com"
			}
		}
	},
	"main": "src/index.ts",
	// "migrations": [
	// 	{
	// 		"new_sqlite_classes": ["Room"],
	// 		"tag": "v1"
	// 	}
	// ],
	"name": "api",
	"observability": {
		"enabled": true
	}
}
