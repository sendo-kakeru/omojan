{
	"devDependencies": {
		"@repo/tsup-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^24.5.2",
		"drizzle-kit": "^0.31.4",
		"drizzle-orm": "^0.44.5",
		"drizzle-valibot": "^0.4.2",
		"valibot": "^1.1.0"
	},
	"exports": {
		"./schema/*": {
			"import": "./dist/esm/*.js",
			"require": "./dist/*.js",
			"types": "./dist/schema/*.d.ts"
		}
	},
	"license": "UNLICENSED",
	"name": "@repo/db",
	"private": true,
	"scripts": {
		"build": "pnpm run \"/^build:/\"",
		"build:tsc": "tsc",
		"build:tsup": "tsup --clean",
		"dev": "pnpm run \"/^dev:/\"",
		"dev:tsc": "tsc --watch",
		"dev:tsup": "tsup --watch",
		"format": "biome check --fix --unsafe .",
		"lint": "biome check .",
		"migrate": "drizzle-kit push",
		"studio": "drizzle-kit studio",
		"type-check": "tsc --noEmit"
	},
	"version": "1.0.0"
}
