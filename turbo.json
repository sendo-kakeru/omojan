{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"cf-typegen": {},
		"db:drop:local": {},
		"db:dump": {},
		"db:gen": {},
		"db:migrate:local": {},
		"db:migrate:prod": {},
		"db:migrate:stg": {},
		"db:push:local": {},
		"db:reset:local": {},
		"destroy": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"format": {},
		"lint": {},
		"storybook": {
			"with": ["storybook:styles"]
		},
		"storybook:styles": {
			"cache": false,
			"persistent": true
		},
		"studio": {},
		"test": {},
		"test:run": {},
		"typecheck": {},
		"up": {}
	}
}
