{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-09-22",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MatchingDurableObject",
				"name": "MATCHING_DURABLE_OBJECT"
			},
			{
				"class_name": "GameDurableObject",
				"name": "GAME_DURABLE_OBJECT"
			}
		]
	},
	"env": {
		"e2e": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MatchingDurableObject",
						"name": "MATCHING_DURABLE_OBJECT"
					},
					{
						"class_name": "GameDurableObject",
						"name": "GAME_DURABLE_OBJECT"
					}
				]
			},
			"services": [{ "binding": "CDN_WORKER", "service": "cdn" }],
			"vars": {
				"ENV": "e2e",
				"WEB_URL": "http://localhost:5173"
			}
		},
		"production": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MatchingDurableObject",
						"name": "MATCHING_DURABLE_OBJECT"
					},
					{
						"class_name": "GameDurableObject",
						"name": "GAME_DURABLE_OBJECT"
					}
				]
			},
			"routes": [{ "custom_domain": true, "pattern": "api.omojan.com" }],
			"services": [{ "binding": "CDN_WORKER", "service": "cdn-production" }],
			// 2時間ごとにクリーンアップを実行
			"triggers": {
				"crons": ["0 */2 * * *"]
			},
			"vars": {
				"ENV": "production",
				"WEB_URL": "https://omojan.com"
			}
		},
		"staging": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MatchingDurableObject",
						"name": "MATCHING_DURABLE_OBJECT"
					},
					{
						"class_name": "GameDurableObject",
						"name": "GAME_DURABLE_OBJECT"
					}
				]
			},
			"routes": [{ "custom_domain": true, "pattern": "api-stg.omojan.com" }],
			"services": [{ "binding": "CDN_WORKER", "service": "cdn-staging" }],
			"vars": {
				"ENV": "staging",
				"WEB_URL": "https://stg.omojan.com"
			}
		}
	},
	"main": "src/index.ts",
	"migrations": [
		{
			"new_sqlite_classes": ["MatchingDurableObject"],
			"tag": "matching-v1"
		},
		{
			"new_sqlite_classes": ["GameDurableObject"],
			"tag": "game-v1"
		}
	],
	"name": "api",
	"observability": {
		"enabled": true
	},
	"services": [{ "binding": "CDN_WORKER", "service": "cdn" }]
}
