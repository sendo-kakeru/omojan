{
	"devDependencies": {
		"@repo/shared": "workspace:*",
		"@repo/tsup-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^24.10.0",
		"drizzle-kit": "^0.31.6",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.44.7",
		"drizzle-valibot": "^0.4.2",
		"pg": "^8.16.3",
		"valibot": "^1.1.0"
	},
	"exports": {
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/index.js"
		}
	},
	"license": "UNLICENSED",
	"name": "@repo/db",
	"private": true,
	"scripts": {
		"build": "pnpm run build:tsup && pnpm run build:tsc",
		"build:tsc": "tsc",
		"build:tsup": "tsup --clean",
		"dev": "pnpm run \"/^dev:/\"",
		"dev:tsc": "tsc --watch",
		"dev:tsup": "tsup --watch",
		"format": "biome check --fix --unsafe .",
		"lint": "biome check .",
		"db:gen": "drizzle-kit generate",
		"db:migrate:production": "ENV=production drizzle-kit migrate",
		"db:migrate:staging": "ENV=staging drizzle-kit migrate",
		"db:migrate:local": "drizzle-kit migrate",
		"db:drop:local": "drizzle-kit drop",
		"db:push:local": "drizzle-kit push",
		"db:dump": "rm src/dump.sql && rm src/local.db && turso db shell omojan-main-stg .dump > src/dump.sql && cat src/dump.sql | sqlite3 src/local.db",
		"studio": "drizzle-kit studio",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"version": "1.0.0",
	"dependencies": {
		"uuidv7": "^1.0.2"
	}
}
