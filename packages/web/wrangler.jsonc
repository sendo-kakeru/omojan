{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-09-22",
	"compatibility_flags": ["nodejs_compat"],
	"env": {
		"production": {
			"routes": [{ "custom_domain": true, "pattern": "omojan.com" }]
		},
		"staging": {
			"routes": [{ "custom_domain": true, "pattern": "stg.omojan.com" }]
		}
	},
	"main": "./workers/app.ts",
	"name": "web",
	"observability": {
		"enabled": true
	}
}
